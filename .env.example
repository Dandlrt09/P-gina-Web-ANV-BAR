# Supabase — copy to `.env` and fill in the values. `.env` / `.env.local` are
# gitignored; never commit real keys.
#
# Only VITE_* variables are inlined into the client bundle by Vite.
# SUPABASE_SERVICE_ROLE_KEY is server-side only (seed/scripts) — it must NEVER
# be prefixed with VITE_ and must never reach the browser bundle.

VITE_SUPABASE_URL=https://uupqxntyrdciocwpqdwo.supabase.co
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=